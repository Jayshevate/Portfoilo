{
  "name": "jaykumar-shevate-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:load": "node tests/load/run.mjs",
    "check": "npm run test && npm run build && npm run test:e2e && npm run test:load",
    "todo": "node scripts/todo.mjs",
    "link": "node scripts/link.mjs"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autocannon": "^7.15.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
